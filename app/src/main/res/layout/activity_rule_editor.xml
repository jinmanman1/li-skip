<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Label"
            android:text="规则名称" />

        <EditText
            android:id="@+id/etName"
            style="@style/Field"
            android:hint="例如：某App 开屏跳过" />

        <TextView
            style="@style/Label"
            android:text="生效的应用包名（逗号分隔，留空=所有应用）" />

        <EditText
            android:id="@+id/etPackages"
            style="@style/Field"
            android:hint="com.example.app" />

        <CheckBox
            android:id="@+id/cbOnlySplash"
            style="@style/Check"
            android:text="只在开屏期间生效" />

        <CheckBox
            android:id="@+id/cbActivityOnly"
            style="@style/Check"
            android:text="只按 Activity 判断（不看节点树，用于广告SDK页面直接返回）" />

        <TextView
            style="@style/Label"
            android:text="Activity 正则" />

        <EditText
            android:id="@+id/etActivityRegex"
            style="@style/Field"
            android:hint="openadsdk|pangle|qq\.e\." />

        <TextView
            style="@style/Label"
            android:text="文字关键词（逗号分隔，任一命中，忽略大小写）" />

        <EditText
            android:id="@+id/etKeywords"
            style="@style/Field"
            android:hint="跳过,跳过广告,skip" />

        <TextView
            style="@style/Label"
            android:text="文字匹配方式" />

        <Spinner
            android:id="@+id/spMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Label"
            android:text="文字正则（可留空）" />

        <EditText
            android:id="@+id/etTextRegex"
            style="@style/Field"
            android:hint="跳过\s*\d+" />

        <TextView
            style="@style/Label"
            android:text="viewId 正则（可留空）" />

        <EditText
            android:id="@+id/etViewId"
            style="@style/Field"
            android:hint=".*skip.*" />

        <TextView
            style="@style/Label"
            android:text="contentDescription 正则（可留空）" />

        <EditText
            android:id="@+id/etDesc"
            style="@style/Field"
            android:hint="关闭|跳过" />

        <TextView
            style="@style/Label"
            android:text="类名包含（可留空）" />

        <EditText
            android:id="@+id/etClass"
            style="@style/Field"
            android:hint="TextView" />

        <TextView
            style="@style/Label"
            android:text="允许区域 l,t,r,b（0~1，相对屏幕，可留空）" />

        <EditText
            android:id="@+id/etRegion"
            style="@style/Field"
            android:hint="0.40,0,1,0.35" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="最大宽度占比" />

                <EditText
                    android:id="@+id/etMaxW"
                    style="@style/Field"
                    android:inputType="numberDecimal"
                    android:hint="0.45" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="最大高度占比" />

                <EditText
                    android:id="@+id/etMaxH"
                    style="@style/Field"
                    android:inputType="numberDecimal"
                    android:hint="0.16" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:text="执行动作" />

        <Spinner
            android:id="@+id/spAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="最低分数（越大越保守）" />

                <EditText
                    android:id="@+id/etMinScore"
                    style="@style/Field"
                    android:inputType="number"
                    android:hint="75" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="冷却时间（毫秒）" />

                <EditText
                    android:id="@+id/etCooldown"
                    style="@style/Field"
                    android:inputType="number"
                    android:hint="1500" />
            </LinearLayout>
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbMustClickable"
            style="@style/Check"
            android:text="节点必须可点击（或其祖先可点击）" />

        <CheckBox
            android:id="@+id/cbAncestor"
            style="@style/Check"
            android:text="允许点击可点击的父节点" />

        <CheckBox
            android:id="@+id/cbPositional"
            style="@style/Check"
            android:text="允许纯位置规则（没有任何文本/id 条件）" />

        <TextView
            style="@style/Label"
            android:text="像素探针（点击前校验某个点颜色，可留空）" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etProbeX"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="x 0~1" />

            <EditText
                android:id="@+id/etProbeY"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="y 0~1" />

            <EditText
                android:id="@+id/etProbeColor"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="#RRGGBB" />

            <EditText
                android:id="@+id/etTolerance"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:inputType="number"
                android:hint="容差" />
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:text="备注" />

        <EditText
            android:id="@+id/etNote"
            style="@style/Field"
            android:hint="随便写点什么" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="保存" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="删除这条规则" />
    </LinearLayout>
</ScrollView>
